
// Shared by the untouched-source baseline and redesigned build.
extension TuckUITests {
  func testReferenceLight() { captureReference(appearance: "Light") }
  func testReferenceDark() { captureReference(appearance: "Dark") }

  private func captureReference(appearance: String) {
    app.terminate()
    app.launchArguments += ["-AppleInterfaceStyle", appearance]
    app.launch()
    popUpWithMouse()
    recordReference("01-empty-\(appearance)")
    app.typeKey(.escape, modifierFlags: [])
    copyToClipboard("A little reminder: send the weekend photos.")
    copyToClipboard("https://www.apple.com/mac/")
    copyToClipboard("Project notes — keep it simple, make it useful.")
    let poster = NSImage(size: NSSize(width: 480, height: 280), flipped: false) { rect in
      NSColor(calibratedRed: 0.13, green: 0.34, blue: 0.37, alpha: 1).setFill()
      rect.fill()
      ("WEEKEND" as NSString).draw(at: NSPoint(x: 32, y: 140), withAttributes: [
        .font: NSFont.systemFont(ofSize: 42, weight: .bold), .foregroundColor: NSColor.white
      ])
      ("A little time outside" as NSString).draw(at: NSPoint(x: 34, y: 102), withAttributes: [
        .font: NSFont.systemFont(ofSize: 22), .foregroundColor: NSColor.white
      ])
      return true
    }
    copyToClipboard(poster)
    popUpWithMouse()
    recordReference("02-history-\(appearance)")
    search("Project")
    recordReference("03-text-search-\(appearance)")
    app.typeKey("p", modifierFlags: [.option])
    waitForSearch()
    recordReference("04-pinned-\(appearance)")
    search("apple")
    recordReference("05-link-search-\(appearance)")
    app.typeKey("u", modifierFlags: [.control])
    search("nothing-matches-this")
    recordReference("06-no-results-\(appearance)")
    app.typeKey("u", modifierFlags: [.control])
    app.typeKey(",", modifierFlags: [.command])
    recordReference("07-settings-\(appearance)", wholeApp: true)
  }

  private func recordReference(_ name: String, wholeApp: Bool = false) {
    let shot = wholeApp ? app.screenshot() : app.dialogs.firstMatch.screenshot()
    let attachment = XCTAttachment(screenshot: shot)
    attachment.name = name
    attachment.lifetime = .keepAlways
    add(attachment)
  }
}
